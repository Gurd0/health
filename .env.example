# Copy to .env and adjust.

# How your browser reaches the server. Google's redirect URI is PUBLIC_URL/oauth/callback and must
# be added to the OAuth client. Google only accepts https:// or http://localhost, so with a LAN IP
# keep the default and log in through an SSH tunnel: ssh -L 8000:localhost:8000 <server>
PUBLIC_URL=http://localhost:8000

# Daily sync time and its time zone.
SYNC_TIME=04:30
SYNC_TZ=Europe/Oslo
TZ=Europe/Oslo

# Host address the port is published on (127.0.0.1, or the server's LAN/Tailscale IP).
BIND=127.0.0.1

# Host user/group that owns ./data, ./raw and ./secrets.
PUID=1000
PGID=1000

# Host port (change it if 8000 is taken, e.g. by Coolify's own dashboard).
PORT=8000

# Optional: where plans, run notes and shoes are stored (default data/training.duckdb).
# HEALTH_TRAINING_DB=/app/data/training.duckdb
